{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.(svg|png|jpg|jpeg|webp|gif|ico)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "player-images",
      "urls": ["https://cdn.fifacm.com/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 300,
        "maxAge": "7d"
      }
    },
    {
      "name": "player-api",
      "urls": ["https://www.fifacm.com/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "4s",
        "maxSize": 100,
        "maxAge": "1d"
      }
    }
  ]
}